## Part A : Tauchen's method on process discretization
"""

# ╔═╡ 46f6fe97-ea95-49aa-b301-f49b91d9ad77
md"""
q1. As Krueger et al. (2015), discretize the process into a five state Markov chain using the Tauchen function from QuantEcon. 
"""

# ╔═╡ 783f9eca-dbf9-46ea-9be0-1e1197d52a52
begin
	# Tauchen discretization function
	function tauchen(mean, sd, rho, num_states; q=3)
	
	    uncond_sd = sd/sqrt(1-rho^2)
	    y = range(-q*uncond_sd, stop = q*uncond_sd, length = num_states)
	    d = y[2]-y[1]
	
	    Pi = zeros(num_states,num_states)
	
	    for row = 1:num_states
	      # end points
	          Pi[row,1] = cdf(Normal(),(y[1] - rho*y[row] + d/2)/sd)
	          Pi[row,num_states] = 1 - cdf(Normal(), (y[num_states] - rho*y[row] - d/2)/sd)
	
	      # middle columns
	          for col = 2:num_states-1
	              Pi[row, col] = (cdf(Normal(),(y[col] - rho*y[row] + d/2) / sd) -
	                             cdf(Normal(),(y[col] - rho*y[row] - d/2) / sd))
	          end
	    end
	
	  yy = y .+ mean # center process around its mean
	
	  Pi = Pi./sum(Pi, dims = 2) # renormalize
	
	  return Pi, yy
	end 
end

# ╔═╡ 9eb140a7-cd59-4efa-81af-b6fadb9008ad
begin 
	# parameter values 
	rho = 0.8
	sigma = sqrt(0.1225)
	N = 5
	N_iter = 2000;
end

# ╔═╡ 8e34a3da-40bc-4313-acae-e43d942d2fd8
begin
	TransMat,log_y_grid = tauchen( 0, sigma,  rho,  N)
end 


# ╔═╡ d3d2c187-f58f-4875-adad-49b5cc5e92fb
md"""
q2. What is the probability matrix? What are the possible values of income y? Hint: careful with the log of income!
"""

# ╔═╡ a836dd88-9945-49bd-a25e-c6322b115192
begin 
	y_grid = exp.(log_y_grid) # income value grid
	#println(join(["Transition matrix : ",round.(TransMat,digits = 3)], ""))
	println("Transition matrix : ")
	display(round.(TransMat,digits = 3))
	println(join(["Income values : ",round.(y_grid,digits = 3)], ""))
end

# ╔═╡ f59c70fb-dd81-40f4-8652-f81503994467
md"""
q3. Create a function to compute the stable distribution. It musts take as input an initial guess of the distribution (vector of N × 1) and the probability matrix (matrix of N × N ). The goal is to find the fixed point. The output should be the stable distribution (vector of N × 1).
"""

# ╔═╡ 3383286c-1b10-4f23-9f3e-006f336b64f6
begin
	## Create a function to get the stable distribution
	function get_invdist(pi_old, delta, maxiter, TransMat)
	   for iter in 1:N_iter
	       pi_next = pi_old*TransMat
	       error = maximum(abs.(pi_next .- pi_old))
	       if error < delta 
	           return pi_next
	           break
	       elseif iter == maxiter
	           error("No solution found after $iter iterations")
	       end
	       pi_old = pi_next
	   end
	end
end

# ╔═╡ d9cf691d-7aa0-4144-8e91-6b2347b1f9ea
begin
	## exogenous parameters and initialization values 
	p = 1/N
	init = transpose(repeat([p],5))
	delta = 1e-12
	maxiter = 3000
end

# ╔═╡ 52b56cdf-91c1-431c-96cc-42d46e5ece2a
begin 
	## stable distribution
	stable_dist = get_invdist(init, delta, maxiter, TransMat)
	println(join(["Stable distribution : ",round.(stable_dist, digits = 3)], ""))
end

# ╔═╡ df36bb5e-563e-44cc-8eb3-f59ac19168b6
md"""
q4. What is the mean income? What is the share of the households with the highest income?
"""

# ╔═╡ c6612ac1-225e-4738-89b8-a47096a1165a
begin
	## mean income
	mean_income = stable_dist*y_grid
	println(join(["Mean income : ",round(mean_income,digits = 3)], ""))
end

# ╔═╡ 77a2304b-ceb1-4677-801b-abfb68444f1b
begin
	## share of household in top income bracket
	share_top = stable_dist[N]
	println(join(["Share of household in the top income bracket : ",round(share_top,digits = 3)], ""))
end

