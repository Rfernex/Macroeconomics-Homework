md"""
## Part B : Recessions
"""

# ╔═╡ 944cc85a-ac26-433b-b9d6-600a1ffeca4d
begin 
	## parameters
	P = [0.971 0.029 0.000 
	    0.145 0.778 0.077
	    0.000 0.508 0.492];
	init_growth = transpose([1,0,0])
end

# ╔═╡ 432594f2-e8bb-4225-9c08-14a27b7b4678
md"""
q1. Assume we are at normal growth, what is the probability of going in recession (mild or severe) next month? In 6 months?
"""

# ╔═╡ cd15e79d-2c0e-4f92-9f96-f4d8c38e27a9
begin
	T1_growth = init_growth*P
	T1_recession_prob = T1_growth[2]+T1_growth[3]
	println(join(["Recession probability at t+1 : ",T1_recession_prob], ""))
end

# ╔═╡ 91d3f260-22f5-443e-afb4-bae3efd8fb68
begin 
	T6_growth = init_growth*P^6
	T6_recession_prob = T6_growth[2]+T6_growth[3]
	println(join(["Recession probability at t+6 : ",round(T6_recession_prob,digits = 3)], ""))
end

# ╔═╡ bbaedb5c-c598-42f7-b447-45c35efb0fb1
md"""
q2. Compute the stable distribution. What is the probability of being in a severe recession in the long run?
"""

# ╔═╡ 15e1a90f-a9a4-427c-9173-0410c93c8dbc
begin
	stable_growth = get_invdist(init_growth, delta, maxiter, P)
	SS_SR_prob = stable_growth[length(stable_growth)]
	println(join(["Stable distribution : ",round.(stable_growth,digits = 3)], ""))
	println(join(["Probability of being in a severe recession in the long run : ",round(SS_SR_prob,digits = 3)], ""))
end

